# Browser-safe Supabase configuration used by the React/Vite frontend.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Server-only secrets. Never prefix these with VITE_ and never commit real values.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"

# Communications delivery is provider-controlled and remains disabled by default.
# Configure these secrets plus a verified sender email before enabling delivery.
# Worker and webhook tokens must be separate long random values.
# Recipient hashing is server-side only and uses Supabase's extensions.pgcrypto boundary.
RESEND_API_KEY="re_your_resend_api_key"
AGILECERT_COMMUNICATIONS_WORKER_TOKEN="generate_a_long_random_worker_token"
AGILECERT_COMMUNICATIONS_WEBHOOK_TOKEN="generate_a_separate_webhook_token"
AGILECERT_COMMUNICATIONS_SIGNING_SECRET="generate_a_long_random_signing_secret"

# APP_URL is used by server-side redirects and callbacks.
APP_URL="MY_APP_URL"
